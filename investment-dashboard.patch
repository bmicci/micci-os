+                  {fmt(pos.totalCost)}
+                </td>
+                <td style={{ padding: '10px 8px', textAlign: 'right', color: isGain ? '#00e5a0' : '#ff6b6b', fontWeight: 500 }}>
+                  {fmt(pos.unrealizedGL)}
